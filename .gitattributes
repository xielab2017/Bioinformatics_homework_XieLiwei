# Treat Office documents as binary so Git never tries to diff them
*.doc  binary
*.docx binary
*.pdf  binary

# Force UTF-8 for all text-based homework files
*.txt   text eol=lf
*.md    text eol=lf
*.R     text eol=lf
*.r     text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.csv   text eol=lf
*.tsv   text eol=lf

# Keep Chinese filenames readable in git status / log
* charset=utf-8
